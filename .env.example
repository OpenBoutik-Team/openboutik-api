# ==============================================================================
# OPENBOUTIK API — CONFIGURATION D'ENVIRONNEMENT LOCAL (EXEMPLE)
# ==============================================================================
# Copiez ce fichier vers .env et renseignez vos valeurs locales :
#   cp .env.example .env
# ==============================================================================

# --- SERVEUR & APPLICATION ---
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# --- BASE DE DONNÉES MYSQL (XAMPP LOCAL) ---
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/openboutik_db"

# --- AUTHENTIFICATION & SÉCURITÉ JWT ---
# Générez des clés robustes pour la production
JWT_ACCESS_SECRET="openboutik_jwt_access_super_secret_local_dev_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="openboutik_jwt_refresh_super_secret_local_dev_key_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# --- CORS (AUTORISATION DES DEUX FRONTS NEXT.JS) ---
# Dev 1 (Marketplace) et Dev 2 (Seller / Super-Admin)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- RÈGLES COMMERCIALES & SÉQUESTRE ---
# Taux de commission par plan SaaS (en pourcentage)
COMMISSION_RATE_FREE=4
COMMISSION_RATE_PRO=3
COMMISSION_RATE_PREMIUM=2

# Délai d'auto-déblocage du séquestre après expédition (en heures)
ESCROW_AUTO_RELEASE_HOURS=48

# --- PASSERELLES MOBILE MONEY SÉNÉGAL (SANDBOX / MOCK DEV) ---
# Wave Senegal API
WAVE_API_KEY="wave_ci_test_sample_key"
WAVE_API_URL="https://api.wave.com/v1"
WAVE_WEBHOOK_SECRET="whsec_sample_wave_dev_secret"

# Orange Money Senegal API
ORANGE_MONEY_CLIENT_ID="om_sample_client_id"
ORANGE_MONEY_CLIENT_SECRET="om_sample_client_secret"
ORANGE_MONEY_API_URL="https://api.orange.com/orange-money-webpay/dev/v1"
ORANGE_MONEY_WEBHOOK_SECRET="om_webhook_sample_secret"
